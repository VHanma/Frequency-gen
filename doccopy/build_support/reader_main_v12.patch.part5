+
+    private void sendReaderAction(String action) {
+        if (!hasExtraction()) {
+            toast("Open a document first");
+            return;
+        }
+        Intent i = new Intent(this, ReaderService.class);
+        i.setAction(action);
+        i.putExtra(ReaderService.EXTRA_SPEED, selectedReaderSpeed());
+        if (ReaderService.ACTION_PLAY.equals(action) || ReaderService.ACTION_RESTART.equals(action)) {
+            androidx.core.content.ContextCompat.startForegroundService(this, i);
+        } else {
+            startService(i);
+        }
+        updateReaderStatus();
+    }
