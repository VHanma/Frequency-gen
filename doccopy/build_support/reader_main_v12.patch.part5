+    };
+
+    private void updateReaderStatus() {
+        if (readerStatusView == null) return;
+        android.content.SharedPreferences p = getSharedPreferences("omega", MODE_PRIVATE);
+        long total = p.getLong("chars", extractedChars);
+        long pos = p.getLong("reader_position", 0);
+        if (total <= 0) {
+            readerStatusView.setText("Reader will be ready after you open a document.");
+            return;
+        }
+        long pct = Math.max(0, Math.min(100, Math.round(pos * 100.0 / total)));
+        readerStatusView.setText("Reading spot: " + pct + "% through the document. READ continues from here.");
     }
 
