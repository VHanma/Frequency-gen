+    private float selectedReaderSpeed() {
+        int i = readerSpeedSpinner == null ? 1 : readerSpeedSpinner.getSelectedItemPosition();
+        float[] rates = {0.75f, 1.0f, 1.25f, 1.5f, 2.0f};
+        i = Math.max(0, Math.min(rates.length - 1, i));
